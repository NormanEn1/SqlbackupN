<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Modo oscuro: las mismas claves de pincel que Theme.xaml con otros colores. Se agrega al final de los recursos de la
      aplicación cuando el modo oscuro está activo (y se quita al volver al claro); como todas las pantallas usan
      DynamicResource para estos pincel, el cambio se ve al instante, sin reiniciar.
    -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B1220"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#131C2E"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#0F1729"/>
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#243049"/>
    <SolidColorBrush x:Key="BorderBrushStrong" Color="#334155"/>
    <SolidColorBrush x:Key="BorderBrushHover" Color="#64748B"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="BodyTextBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="PrimaryTintBrush" Color="#172554"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="DangerDarkBrush" Color="#FCA5A5"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#7F1D1D"/>
    <SolidColorBrush x:Key="DangerTintBrush" Color="#2A1215"/>
    <SolidColorBrush x:Key="DangerTintPressedBrush" Color="#3B1518"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="WarningDotBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="WarningTintBrush" Color="#2A2110"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="SuccessDotBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="SuccessTintBrush" Color="#10241A"/>
    <SolidColorBrush x:Key="NeutralDotBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#0A0F1C"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#162036"/>
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#1E3A8A"/>
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#1B2740"/>
    <SolidColorBrush x:Key="HoverBrush2" Color="#243049"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="#2F5FBF"/>
    <SolidColorBrush x:Key="GhostHoverBrush" Color="#1F2A44"/>
    <SolidColorBrush x:Key="GhostPressedBrush" Color="#2A3856"/>
    <SolidColorBrush x:Key="TabHoverBrush" Color="#18233B"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3A4A66"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#51627F"/>
    <SolidColorBrush x:Key="ScrollThumbPressedBrush" Color="#6B7C99"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#60A5FA"/>
    <SolidColorBrush x:Key="PrimaryBorderBrush" Color="#1E3A8A"/>
</ResourceDictionary>
