<Window x:Class="SqlBackupN.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SqlBackupN.App.Controls"
        Title="SQL Backup N · Centinela Appliance" Height="720" Width="1240" MinWidth="1040" MinHeight="580">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Barra lateral: marca y lista de jobs ================= -->
        <Grid Grid.Row="0" Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="20,24,20,22">
                <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource PrimaryBrush}">
                    <TextBlock Text="&#xEA18;" Style="{StaticResource IconText}" FontSize="18" Foreground="White"
                               HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="SQL Backup N" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Centinela Appliance" Foreground="{StaticResource SidebarMutedBrush}" FontSize="11.5"/>
                </StackPanel>
            </StackPanel>

            <Button Grid.Row="1" Style="{StaticResource PrimaryButton}" Tag="&#xE710;" Content="Nuevo job"
                    Margin="16,0,16,20" Padding="14,9" Command="{Binding NewJobCommand}"/>

            <TextBlock Grid.Row="2" Text="JOBS" Foreground="{StaticResource SidebarMutedBrush}" FontSize="11"
                       FontWeight="SemiBold" Margin="22,0,0,6"/>

            <ListBox Grid.Row="3" ItemsSource="{Binding Jobs}" SelectedItem="{Binding Selected}"
                     ItemContainerStyle="{StaticResource SidebarItem}"
                     Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding NextInfo}" Foreground="{StaticResource SidebarMutedBrush}"
                                           FontSize="11.5" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ================= Centro: bienvenida o detalle del job ================= -->
        <Grid Grid.Row="0" Grid.Column="1" Background="{StaticResource AppBackgroundBrush}">
            <!-- Sin jobs -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <Border Width="84" Height="84" CornerRadius="42" Background="{StaticResource PrimaryTintBrush}"
                        HorizontalAlignment="Center">
                    <TextBlock Text="&#xEA18;" Style="{StaticResource IconText}" FontSize="36"
                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="Bienvenido a SQL Backup N" Style="{StaticResource Heading}" FontSize="26"
                           TextAlignment="Center" Margin="0,24,0,0"/>
                <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" FontSize="14" LineHeight="22"
                           Margin="0,10,0,26"
                           Text="Aún no hay ningún job. Un job define qué bases respaldar, cuándo, dónde guardarlas y a quién avisar."/>
                <Button Style="{StaticResource PrimaryButton}" Tag="&#xE710;" Content="Crear mi primer job"
                        Padding="22,11" FontSize="14" HorizontalAlignment="Center" Command="{Binding NewJobCommand}"/>
            </StackPanel>

            <!-- Con jobs -->
            <Grid Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="32,28,32,18">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Selected.NextInfo}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Tag="&#xE768;" Content="Ejecutar ahora"
                                Margin="0,0,18,0" Command="{Binding RunNowCommand}"/>
                        <Button Tag="&#xE70F;" Content="Editar" Margin="0,0,8,0" Command="{Binding EditJobCommand}"/>
                        <Button Tag="&#xE8C8;" Content="Duplicar" Margin="0,0,8,0" Command="{Binding DuplicateJobCommand}"/>
                        <Button Style="{StaticResource DangerButton}" Tag="&#xE74D;" Content="Eliminar"
                                Command="{Binding DeleteJobCommand}"/>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="26,0,26,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ctl:InfoCard Grid.Row="0" Grid.Column="0" Margin="6" Icon="&#xE839;" Title="Servidor SQL"
                                      Text="{Binding ServerText}"/>
                        <ctl:InfoCard Grid.Row="0" Grid.Column="1" Margin="6" Icon="&#xE8A5;" Title="Bases de datos"
                                      Text="{Binding DatabasesText}"/>
                        <ctl:InfoCard Grid.Row="1" Grid.Column="0" Margin="6" Icon="&#xE787;" Title="Programación"
                                      Text="{Binding ScheduleText}"/>
                        <ctl:InfoCard Grid.Row="1" Grid.Column="1" Margin="6" Icon="&#xE8B7;" Title="Destinos"
                                      Text="{Binding DestinationsText}"/>
                        <ctl:InfoCard Grid.Row="2" Grid.Column="0" Margin="6" Icon="&#xE81C;" Title="Retención"
                                      Text="{Binding RetentionText}"/>
                        <ctl:InfoCard Grid.Row="2" Grid.Column="1" Margin="6" Icon="&#xE715;" Title="Avisos"
                                      Text="{Binding NotificationsText}"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ================= Historial ================= -->
        <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="22,28,14,14">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Tag="&#xE72C;"
                            Command="{Binding RefreshCommand}" ToolTip="Actualizar"/>
                    <TextBlock Text="Historial" Style="{StaticResource SectionTitle}" FontSize="17" VerticalAlignment="Center"/>
                </DockPanel>

                <TextBlock Grid.Row="1" Text="Todavía no hay ejecuciones registradas." Style="{StaticResource Muted}"
                           Margin="22,4,22,0" VerticalAlignment="Top"
                           Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVisibility}}"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding History}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="14,0,14,8" Padding="14,11" CornerRadius="8"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding When}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource StatusChip}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusChipText}"/>
                                        </Border>
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}"
                                                   Style="{StaticResource HistoryDetail}" Margin="0,8,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ================= Barra de estado ================= -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="18,7">
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
