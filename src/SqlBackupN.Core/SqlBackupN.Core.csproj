<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>SqlBackupN.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- La documentación XML se exige por convención (docs/rules.md), pero no rompe la compilación. -->
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Cronos" Version="0.13.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.21" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.21" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.21" />
  </ItemGroup>
</Project>
